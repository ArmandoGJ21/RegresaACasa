# Copia este archivo a backend/.env (git lo ignora; NUNCA subas el .env real).
# Formato KEY=VALUE. "__" equivale a ":" en appsettings.json.
# Las variables de entorno del sistema tienen prioridad sobre este archivo.
# Reglas completas: docs/azure-blob-storage.md#restricciones-del-env
# La API valida todo al arrancar y no inicia si algo es inválido.

# ---------- Base de datos (PostgreSQL) ----------
# Development: opcional (vacío = base en memoria con datos de ejemplo).
# Otros entornos: OBLIGATORIA.
# ConnectionStrings__Default=Host=localhost;Port=5432;Database=regresaacasa;Username=postgres;Password=postgres

# ---------- Azure Blob Storage ----------
# Development: opcional (vacío = POST /api/v1/uploads/images responde 503).
# Otros entornos: OBLIGATORIA, con https y sin Azurite.
# Debe incluir AccountName y AccountKey (se usan para firmar las URLs SAS).
#   Azure real (lo escribe infra/deploy-storage.ps1):
#     DefaultEndpointsProtocol=https;AccountName=<cuenta>;AccountKey=<llave>;EndpointSuffix=core.windows.net
#   Azurite local (docker compose up -d):
#     UseDevelopmentStorage=true
# AzureBlob__ConnectionString=UseDevelopmentStorage=true

# 3-63 caracteres: minúsculas, números y guiones; sin "--" ni guion al inicio/fin.
AzureBlob__ContainerName=pet-images

# Vigencia de la URL de subida en minutos (1-60).
AzureBlob__SasExpiryMinutes=10

# Vigencia de las URLs de lectura que devuelve el muro, en minutos (5-1440).
# El contenedor es privado: sin firma nadie puede ver las fotos.
AzureBlob__ReadSasMinutes=60

# ---------- Límites anti-abuso (responden 429) ----------
# URLs de subida de fotos por IP por minuto (1-1000).
RateLimits__UploadsPerMinutePerIp=5
# Tope GLOBAL de fotos por día, todas las IPs juntas (1-100000). Protege el Storage de sobrecarga.
RateLimits__UploadsPerDay=200
# Publicaciones + comentarios por IP por minuto (1-1000).
RateLimits__WritesPerMinutePerIp=20
