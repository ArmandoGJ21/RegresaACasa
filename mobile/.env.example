# Copia este archivo a .env.local y ajusta la URL de la API.
# Emulador Android: http://10.0.2.2:5105 | Celular fisico: http://<IP-de-tu-PC>:5105
EXPO_PUBLIC_API_URL=http://localhost:5105

# true = no sube la foto a Azure y usa una imagen de relleno (util si no hay Azure/Azurite)
EXPO_PUBLIC_SKIP_IMAGE_UPLOAD=false
