# Copia este archivo a mobile/.env.local (git lo ignora).
# Reglas completas: docs/azure-blob-storage.md#restricciones-del-env
#
# IMPORTANTE: las variables EXPO_PUBLIC_* quedan dentro de la app y son públicas.
# Nunca pongas aquí la llave de Azure (AccountKey) ni contraseñas.

# OBLIGATORIA. URL http(s) de la API, sin "/" final ni query.
#   Emulador Android: http://10.0.2.2:5105
#   Celular físico (misma Wi-Fi): http://<IP-de-tu-PC>:5105
#   Producción: debe ser https://
EXPO_PUBLIC_API_URL=http://localhost:5105

# Opcional: "true" o "false" (por defecto false).
# true = no sube la foto a Azure y usa una imagen de relleno. Solo en desarrollo.
EXPO_PUBLIC_SKIP_IMAGE_UPLOAD=false
